ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_COVER_STYLE=line-art
# Free image-generation alternative (Cloudflare Workers AI's plain REST API,
# not a Worker binding — this project's hosting platform only provisions
# D1/R2 bindings). Get CLOUDFLARE_ACCOUNT_ID and an API token with
# "Workers AI - Read" + "Workers AI - Edit" permissions from the Cloudflare
# dashboard. Used automatically instead of OpenAI when both are set — see
# IMAGE_PROVIDER to override.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_PROVIDER=
TRIPQUEST_OWNER_EMAIL=
TRIPQUEST_PUBLIC_URL=https://tripquestkids.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The mailed explorer kit is the only paid product (the PDF is free).
STRIPE_KIT_PRICE_ID=
STRIPE_KIT_PRICE_CENTS=1990
STRIPE_CURRENCY=sgd
