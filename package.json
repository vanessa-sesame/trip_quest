{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "benchmark:20": "tsx --env-file=.env.local scripts/benchmark-booklets.ts",
    "uat:parent-50": "tsx --env-file=.env.local scripts/benchmark-booklets.ts",
    "uat:aggregate": "node --experimental-strip-types scripts/aggregate-uat-results.ts",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "pdf:sample": "node --experimental-strip-types scripts/create-pdf-sample.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/booklet.test.ts tests/booklet-preview.test.ts tests/storage.test.ts tests/request-security.test.ts tests/generation-stream.test.ts tests/pdf.test.ts tests/family.test.ts tests/payment.test.ts tests/coloring.test.ts tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.3.5",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "type": "module"
}
